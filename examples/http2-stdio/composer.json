{
  "name": "mcp/example-http2-stdio",
  "description": "Standalone demo: speaking HTTP/2 over STDIO pipes with the Amp HTTP client and server",
  "license": "Apache-2.0",
  "type": "project",
  "require": {
    "php": "^8.1",
    "amphp/byte-stream": "^2.1",
    "amphp/http-client": "^5.3",
    "amphp/http-server": "^3.4",
    "amphp/process": "^2.0",
    "amphp/socket": "^2.3",
    "psr/log": "^2.0 || ^3.0"
  },
  "autoload": {
    "psr-4": {
      "Mcp\\Example\\Http2Stdio\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
